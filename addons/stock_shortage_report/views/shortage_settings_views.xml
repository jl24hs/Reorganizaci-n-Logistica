<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_shortage_settings_form" model="ir.ui.view">
        <field name="name">stock.shortage.settings.form</field>
        <field name="model">stock.shortage.settings</field>
        <field name="arch" type="xml">
            <form string="Configuración de faltantes de stock">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="period_days"/>
                        <field name="threshold_days"/>
                        <field name="apply_d1_workaround"/>
                        <field name="notify_user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_shortage_settings" model="ir.actions.act_window">
        <field name="name">Configuración general</field>
        <field name="res_model">stock.shortage.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>
</odoo>
